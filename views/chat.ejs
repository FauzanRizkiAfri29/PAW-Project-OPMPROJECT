<%- include('partials/header', { title: title, active: 'chat' }) %>

  <main class="content">

    <div class="left">

      <section class="card">
        <h2>Tanya PAI</h2>
        <p class="muted">Tanyakan materi Pendidikan Agama Islam kepada asisten belajar. Sebaiknya didampingi guru.</p>

        <details class="konteks">
          <summary>Materi dari guru (opsional)</summary>
          <textarea id="context" rows="4" maxlength="3000" class="hasil-area"
            placeholder="Tempel materi di sini agar AI menjawab berdasarkan materi ini..."></textarea>
        </details>

        <div id="chat-box" class="chat-box">
          <div class="msg bot">Assalamualaikum! Aku TanyaPAI. Silakan tanya tentang materi PAI ya.</div>
        </div>

        <form id="chat-form" class="form-row">
          <input type="text" id="message" maxlength="500" placeholder="Tulis pertanyaanmu..." autocomplete="off" required>
          <button type="submit" id="send-btn" class="btn">Kirim</button>
        </form>
        <p class="note">Jawaban AI bisa keliru. Tanyakan kepada guru PAI jika kamu ragu.</p>
      </section>

    </div>

    <aside class="card">
      <h2>Tips</h2>
      <p class="muted">Gunakan kalimat yang sederhana, misalnya "Apa saja rukun Islam?".</p>
      <p class="muted">Guru bisa menempelkan materi di kotak "Materi dari guru" agar jawaban sesuai pelajaran.</p>
      <p class="muted">Pertanyaan di luar PAI tidak akan dijawab.</p>
    </aside>

  </main>

  <script src="/js/chat.js"></script>

<%- include('partials/footer') %>